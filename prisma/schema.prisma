generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  nama         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  sessions     Session[]
  budgets      Budget[]      // ← BARU untuk SRS010
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipe        Tipe
  nominal     Decimal
  kategori    String
  tanggal     DateTime
  keterangan  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, tanggal])
}

model Budget {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bulan     Int      // 1-12
  tahun     Int      // contoh: 2026
  nominal   Decimal  // batas anggaran bulanan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bulan, tahun])
  @@index([userId, tahun, bulan])
}

enum Tipe {
  PEMASUKAN
  PENGELUARAN
}